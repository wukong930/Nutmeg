NUTMEG_ENV=local
NUTMEG_COMPETITION_CONFIG_DIR=configs/competitions
NUTMEG_V4_ARTIFACT_PATH=data/v4_model
NUTMEG_V4_OBSERVATION_DB=data/v4_observation.db
NUTMEG_LOG_LEVEL=INFO

# Free data sources (W3): no credentials required for understat / clubelo / OddsPortal

# V6 W1: API-Football paid subscription (Pro plan ~$19/mo)
# Sign up at https://dashboard.api-football.com → API → copy key here
# NEVER commit the real key. .env is gitignored; .env.example (this file) IS committed.
NUTMEG_API_FOOTBALL_KEY=
NUTMEG_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
NUTMEG_API_FOOTBALL_TIMEOUT_SECONDS=15
